{
  "id": "saga_add_grid_values_points",
  "title": "Add Alkmaar DEM values to point features",
  "process_id": "SAGA.shapes_grid.0",
  "execution_mode": "sync",
  "method": "POST",
  "path": "/processes/SAGA.shapes_grid.0/execution",
  "headers": {
    "Accept": "application/json",
    "Content-Type": "application/json"
  },
  "body": {
    "inputs": {
      "SHAPES": {
        "href": "https://raw.githubusercontent.com/Gouwe-Gozer/ogc-processes-tests/2f18a402e520ddc90e63c8cee7ccf2296c70f0b8/fixtures/points/five_points.geojson",
        "type": "application/json"
      },
      "GRIDS": {
        "href": "https://raw.githubusercontent.com/Gouwe-Gozer/ogc-processes-tests/2f18a402e520ddc90e63c8cee7ccf2296c70f0b8/fixtures/raster/alkmaar_dem.asc",
        "type": "application/x-ogc-aaigrid"
      },
      "RESAMPLING": "Bilinear Interpolation"
    },
    "outputs": {
      "RESULT": {
        "format": {
          "mediaType": "application/json"
        },
        "transmissionMode": "value"
      }
    },
    "response": "document"
  },
  "fixtures": [
    "../../../../fixtures/points/five_points.geojson",
    "../../../../fixtures/raster/alkmaar_dem.asc"
  ],
  "expected_status": 200,
  "notes": "Combines a referenced vector with the required raster list input."
}
