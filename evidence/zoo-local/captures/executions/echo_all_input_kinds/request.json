{
  "id": "echo_all_input_kinds",
  "title": "Echo literal, JSON, and bounding-box inputs",
  "process_id": "EchoProcess",
  "execution_mode": "sync",
  "method": "POST",
  "path": "/processes/EchoProcess/execution",
  "headers": {
    "Accept": "application/json",
    "Content-Type": "application/json"
  },
  "body": {
    "inputs": {
      "literalInput": "Alkmaar",
      "complexInput": {
        "value": {
          "message": "Hello from Alkmaar"
        }
      },
      "c": {
        "bbox": [
          4.74,
          52.62,
          4.77,
          52.65
        ],
        "crs": "urn:ogc:def:crs:EPSG:6.6:4326"
      }
    },
    "outputs": {
      "literalOutput": {
        "transmissionMode": "value"
      },
      "complexOutput": {
        "format": {
          "mediaType": "application/json"
        },
        "transmissionMode": "value"
      },
      "c": {
        "transmissionMode": "value"
      }
    },
    "response": "document"
  },
  "expected_status": 200,
  "notes": "Exercises the three optional input and output shapes advertised by EchoProcess."
}
