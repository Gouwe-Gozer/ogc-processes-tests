{
  "method": "POST",
  "url": "{{baseUrl}}/processes/SAGA.grid_tools.27/execution",
  "headers": {
    "Accept": "application/json",
    "Content-Type": "application/json"
  },
  "body": {
    "inputs": {
      "GRID": {
        "href": "https://raw.githubusercontent.com/Gouwe-Gozer/ogc-processes-tests/2f18a402e520ddc90e63c8cee7ccf2296c70f0b8/fixtures/raster/alkmaar_dem.asc",
        "type": "application/x-ogc-aaigrid"
      },
      "METHOD": "number of grid cells per tile",
      "NX": 3,
      "NY": 3,
      "OVERLAP": 0,
      "TILES_SAVE": false
    },
    "outputs": {
      "TILES": {
        "format": {
          "mediaType": "image/tiff"
        },
        "transmissionMode": "reference"
      }
    },
    "response": "document"
  }
}
