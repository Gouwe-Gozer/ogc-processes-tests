{
  "id": "async_results_not_ready",
  "title": "Results are requested before the job reaches successful",
  "category": "request_error",
  "execution": "manual-only",
  "process_id": "longProcess",
  "source": {
    "profile_id": "zoo-ubuntu18-gdal3-saga7-otb7",
    "captured_at": "2026-08-25",
    "normalization": "Job IDs and timestamps are templated. The live sequence is timing-sensitive."
  },
  "steps": [
    {
      "id": "submit",
      "request": "01-submit.request.json",
      "representative_response": "01-submit.response.json",
      "expect": {
        "http_status": [201],
        "job_status": ["accepted", "running"],
        "capture": {
          "jobUrl": "response.headers.location",
          "jobId": "response.body.jobID"
        }
      },
      "expected_client_behavior": {
        "classification": "job-accepted",
        "must": [
          "Retain the non-terminal job state."
        ],
        "must_not": [
          "Issue the next results request during ordinary client operation; it is deliberately premature."
        ]
      }
    },
    {
      "id": "get-results-too-early",
      "request": "02-get-results-too-early.request.json",
      "representative_response": "02-get-results-too-early.response.json",
      "expect": {
        "http_status": [404],
        "problem_title": ["ResultNotReady"]
      },
      "expected_client_behavior": {
        "classification": "results-not-ready",
        "must": [
          "Expose the OGC problem detail while retaining the job as non-terminal.",
          "Direct the lifecycle back to job-status retrieval rather than repeating the result request."
        ],
        "must_not": [
          "Classify the job itself as failed from this 404.",
          "Treat the missing result resource as a network failure.",
          "Return an empty successful result."
        ]
      }
    },
    {
      "id": "cleanup",
      "request": "03-cleanup.request.json",
      "representative_response": "03-cleanup.response.json",
      "expect": {
        "http_status": [200],
        "job_status": ["dismissed"]
      },
      "expected_client_behavior": {
        "classification": "job-dismissed",
        "must": [
          "Use DELETE to clean up the timing-sensitive test job."
        ],
        "must_not": [
          "Confuse cleanup dismissal with the earlier ResultNotReady problem."
        ]
      }
    }
  ]
}
