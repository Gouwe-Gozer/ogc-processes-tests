{
  "id": "Gdal_Contour",
  "title": "Builds vector contour lines from a raster elevation model.",
  "description": "http://www.gdal.org/gdal_contour.html",
  "mutable": false,
  "version": "1.0.0",
  "jobControlOptions": [
    "sync-execute",
    "async-execute",
    "dismiss"
  ],
  "outputTransmission": [
    "value",
    "reference"
  ],
  "links": [
    {
      "rel": "http://www.opengis.net/def/rel/ogc/1.0/execute",
      "type": "application/json",
      "title": "Execute End Point",
      "href": "http://localhost/ogc-api/processes/Gdal_Contour/execution"
    },
    {
      "rel": "alternate",
      "type": "text/html",
      "title": "Execute End Point",
      "href": "http://localhost/ogc-api/processes/Gdal_Contour/execution.html"
    }
  ],
  "inputs": {
    "InputDSN": {
      "title": "The input data source name",
      "description": "The input data source name to use.",
      "schema": {
        "type": "string"
      }
    },
    "OutputDSN": {
      "title": "The output data source name",
      "description": "The output data source name.",
      "schema": {
        "type": "string"
      }
    },
    "i": {
      "title": "An interval value",
      "description": "The elevation interval between contours.",
      "schema": {
        "type": "string"
      }
    },
    "a": {
      "title": "Attribute name",
      "description": "provides a name for the attribute in which to put the elevation. If not provided no elevation attribute is attached.",
      "minOccurs": 0,
      "schema": {
        "type": "string",
        "nullable": true
      }
    },
    "b": {
      "title": "The band number",
      "description": "A particular band, defaults to band 1.",
      "minOccurs": 0,
      "schema": {
        "type": "integer",
        "nullable": true
      }
    }
  },
  "outputs": {
    "Result": {
      "title": "The resulting converted file",
      "description": "The file name resulting of the convertion",
      "schema": {
        "type": "string"
      }
    }
  }
}
