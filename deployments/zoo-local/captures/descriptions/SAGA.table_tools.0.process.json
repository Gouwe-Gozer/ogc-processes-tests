{
  "id": "SAGA.table_tools.0",
  "title": "Create New Table",
  "description": "Creates a new empty table.&lt;br/&gt;&lt;br/&gt;Possible field types are:&lt;br/&gt;- string&lt;br/&gt;- date&lt;br/&gt;- color&lt;br/&gt;- unsigned 1 byte integer&lt;br/&gt;- signed 1 byte integer&lt;br/&gt;- unsigned 2 byte integer&lt;br/&gt;- signed 2 byte integer&lt;br/&gt;- unsigned 4 byte integer&lt;br/&gt;- signed 4 byte integer&lt;br/&gt;- unsigned 8 byte integer&lt;br/&gt;- signed 8 byte integer&lt;br/&gt;- 4 byte floating point number&lt;br/&gt;- 8 byte floating point number&lt;br/&gt;- binary&lt;br/&gt;",
  "mutable": false,
  "version": "1.0.0",
  "jobControlOptions": [
    "sync-execute",
    "async-execute",
    "dismiss"
  ],
  "outputTransmission": [
    "value",
    "reference"
  ],
